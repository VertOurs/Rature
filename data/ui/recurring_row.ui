<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="RatureRecurringRow" parent="AdwActionRow">
    <!-- title and subtitle are set from Python: the subtitle is a
         locale-derived list of weekday names, not a catalogue string. -->
    <child type="suffix">
      <object class="GtkMenuButton" id="menu_button">
        <property name="icon-name">view-more-symbolic</property>
        <property name="valign">center</property>
        <style>
          <class name="flat"/>
        </style>
        <property name="popover">
          <object class="GtkPopover" id="row_popover">
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="margin-start">6</property>
                <property name="margin-end">6</property>
                <property name="margin-top">6</property>
                <property name="margin-bottom">6</property>
                <child>
                  <object class="GtkButton" id="edit_button">
                    <property name="label" translatable="yes">Edit</property>
                    <property name="halign">fill</property>
                    <style>
                      <class name="flat"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="delete_button">
                    <property name="label" translatable="yes">Delete</property>
                    <property name="halign">fill</property>
                    <style>
                      <class name="flat"/>
                      <class name="destructive-action"/>
                    </style>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
