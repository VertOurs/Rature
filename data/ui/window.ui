<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">About Rature</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
  <template class="RatureWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="no">Rature</property>
    <property name="content">
      <object class="AdwNavigationSplitView" id="split_view">
        <property name="sidebar">
          <object class="AdwNavigationPage">
            <property name="title" translatable="no">Rature</property>
            <property name="child">
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar">
                    <child type="end">
                      <object class="GtkMenuButton">
                        <property name="icon-name">open-menu-symbolic</property>
                        <property name="menu-model">primary_menu</property>
                        <property name="primary">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <property name="content">
                  <object class="GtkListBox" id="sidebar_list">
                    <property name="selection-mode">single</property>
                    <style>
                      <class name="navigation-sidebar"/>
                    </style>
                    <child>
                      <object class="GtkListBoxRow">
                        <property name="child">
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Day</property>
                            <property name="xalign">0</property>
                            <property name="margin-start">6</property>
                            <property name="margin-end">6</property>
                            <property name="margin-top">6</property>
                            <property name="margin-bottom">6</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBoxRow">
                        <property name="child">
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Reserve</property>
                            <property name="xalign">0</property>
                            <property name="margin-start">6</property>
                            <property name="margin-end">6</property>
                            <property name="margin-top">6</property>
                            <property name="margin-bottom">6</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBoxRow">
                        <property name="child">
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Recurring</property>
                            <property name="xalign">0</property>
                            <property name="margin-start">6</property>
                            <property name="margin-end">6</property>
                            <property name="margin-top">6</property>
                            <property name="margin-bottom">6</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
        <property name="content">
          <object class="AdwNavigationPage" id="day_page">
            <property name="title" translatable="yes">Day</property>
            <!-- Content is DayView, attached in RatureWindow.__init__: it
                 needs App, which template XML has no way to pass in. -->
          </object>
        </property>
      </object>
    </property>
  </template>
  <object class="AdwNavigationPage" id="reserve_page">
    <property name="title" translatable="yes">Reserve</property>
    <!-- Content is ReserveView, attached in RatureWindow.__init__: it
         needs App, which template XML has no way to pass in. -->
  </object>
  <object class="AdwNavigationPage" id="recurring_page">
    <property name="title" translatable="yes">Recurring</property>
    <!-- Placeholder. Replaced by the real Recurring view, ROADMAP.md chantier 3 step 8. -->
    <property name="child">
      <object class="AdwStatusPage">
        <property name="title" translatable="yes">Recurring</property>
      </object>
    </property>
  </object>
</interface>
