<component type="desktop-application">
  <id>io.github.vertours.Rature</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Rature</name>
  <summary>Your day, one line at a time</summary>

  <description>
    <p>
      Rature keeps one numbered list for the day. You add tasks one by one,
      in no particular order, and strike them through as the day goes. Struck
      tasks stay visible in a block at the top: there is no planning, no
      categories, no scoring, no encouragement.
    </p>
  </description>

  <launchable type="desktop-id">io.github.vertours.Rature.desktop</launchable>
  <translation type="gettext">rature</translation>

  <url type="homepage">https://github.com/VertOurs/Rature</url>
  <url type="bugtracker">https://github.com/VertOurs/Rature/issues</url>
  <url type="vcs-browser">https://github.com/VertOurs/Rature</url>

  <developer id="io.github.vertours">
    <name>VertOurs</name>
  </developer>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.6.0" date="2026-08-31">
      <description>
        <p>
          The Reserve view: add entries, rename them in place, delete them,
          and send one into the day. The Recurring view and the archive
          window are still to come.
        </p>
      </description>
    </release>
    <release version="0.5.0" date="2026-08-31">
      <description>
        <p>
          Day view tasks can be reordered by dragging a row within its own
          block. The Reserve and Recurring views and the archive window are
          still to come.
        </p>
      </description>
    </release>
    <release version="0.4.0" date="2026-08-31">
      <description>
        <p>
          The Day view works: add, strike, unstrike, rename in place, delete
          and freeze the list. Drag-and-drop reordering, the Reserve and
          Recurring views, and the archive window are still to come.
        </p>
      </description>
    </release>
    <release version="0.3.0" date="2026-08-31">
      <description>
        <p>
          The first visible feature: a main window with sidebar navigation
          between the Day, Reserve and Recurring views (still placeholders),
          window size persisted, an About dialog. Reading the daily list back
          is still not possible.
        </p>
      </description>
    </release>
    <release version="0.2.0" date="2026-08-31">
      <description>
        <p>
          Complete core business logic and the App coordination layer: the
          day list and its operations, the reserve, recurring templates, the
          day rollover, atomic JSON storage. Still no graphical interface.
        </p>
      </description>
    </release>
    <release version="0.1.0" date="2026-08-29">
      <description>
        <p>Project foundations. Not a functional release.</p>
      </description>
    </release>
  </releases>
</component>