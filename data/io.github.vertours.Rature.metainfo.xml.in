<component type="desktop-application">
  <id>io.github.vertours.Rature</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Rature</name>
  <summary>Your day, one line at a time</summary>

  <description>
    <p>
      Rature keeps one numbered list for the day. You add tasks one by one,
      in no particular order, and strike them through as the day goes. Struck
      tasks stay visible in a block at the top: there is no planning, no
      categories, no scoring, no encouragement.
    </p>
    <p>
      Striking is not deleting: a struck task stays visible as a trace of
      what got done, a deleted one leaves without a shown trace. Beside the
      day list, an undated reserve holds what is not scheduled, and
      recurring templates come back on their weekdays. Past days are kept,
      searchable and read-only.
    </p>
  </description>

  <launchable type="desktop-id">io.github.vertours.Rature.desktop</launchable>
  <translation type="gettext">rature</translation>

  <url type="homepage">https://github.com/VertOurs/Rature</url>
  <url type="bugtracker">https://github.com/VertOurs/Rature/issues</url>
  <url type="vcs-browser">https://github.com/VertOurs/Rature</url>
  <url type="contribute">https://github.com/VertOurs/Rature/blob/main/CONTRIBUTING.md</url>

  <developer id="io.github.vertours">
    <name>VertOurs</name>
  </developer>

  <content_rating type="oars-1.1"/>

  <branding>
    <!-- The red strike of the icon (data/icons/.../Rature.svg). -->
    <color type="primary" scheme_preference="light">#e01b24</color>
    <color type="primary" scheme_preference="dark">#ed333b</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/VertOurs/Rature/main/data/screenshots/day.png</image>
      <caption>The Day view: struck tasks on top, active tasks below, stable numbers</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/VertOurs/Rature/main/data/screenshots/recurring.png</image>
      <caption>Recurring templates and the form to add one</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/VertOurs/Rature/main/data/screenshots/archives.png</image>
      <caption>The Archives window: a past day, read-only, with search</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/VertOurs/Rature/main/data/screenshots/statistics.png</image>
      <caption>The Statistics window: counts per archived day</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.10.0" date="2026-09-03">
      <description>
        <p>
          The comfort features and the translation. You can undo the last
          deletion, add a task already struck in one gesture, copy a day
          to the clipboard as plain text, and reach every action with a
          keyboard shortcut listed in a help window. The Archives window
          gains a search over task text, a read-only Statistics window
          shows plain counts per archived day, and the interface is fully
          translated to French.
        </p>
      </description>
    </release>
    <release version="0.9.0" date="2026-09-02">
      <description>
        <p>
          The main window adapts to narrow widths: under 500 units, the
          sidebar becomes its own page with a back button, and the Day
          view keeps its entry bar and full task text. This completes
          the interface rebuild.
        </p>
      </description>
    </release>
    <release version="0.8.0" date="2026-09-02">
      <description>
        <p>
          A read-only Archives window, opened from the main menu: a
          sidebar of every archived date, most recent first, and the
          matching day on the right, laid out like the Day view. An
          archive that fails to load shows a neutral message instead of
          blocking the others.
        </p>
      </description>
    </release>
    <release version="0.7.0" date="2026-08-31">
      <description>
        <p>
          The Recurring view: create, edit and delete task templates and
          pick the weekdays they run on. A reserve row can now be dragged
          onto the Day entry in the sidebar. Day and month names follow the
          system language. This completes the interface rebuild.
        </p>
      </description>
    </release>
    <release version="0.6.0" date="2026-08-31">
      <description>
        <p>
          The Reserve view: add entries, rename them in place, delete them,
          and send one into the day. The Recurring view and the archive
          window are still to come.
        </p>
      </description>
    </release>
    <release version="0.5.0" date="2026-08-31">
      <description>
        <p>
          Day view tasks can be reordered by dragging a row within its own
          block. The Reserve and Recurring views and the archive window are
          still to come.
        </p>
      </description>
    </release>
    <release version="0.4.0" date="2026-08-31">
      <description>
        <p>
          The Day view works: add, strike, unstrike, rename in place, delete
          and freeze the list. Drag-and-drop reordering, the Reserve and
          Recurring views, and the archive window are still to come.
        </p>
      </description>
    </release>
    <release version="0.3.0" date="2026-08-31">
      <description>
        <p>
          The first visible feature: a main window with sidebar navigation
          between the Day, Reserve and Recurring views (still placeholders),
          window size persisted, an About dialog. Reading the daily list back
          is still not possible.
        </p>
      </description>
    </release>
    <release version="0.2.0" date="2026-08-31">
      <description>
        <p>
          Complete core business logic and the App coordination layer: the
          day list and its operations, the reserve, recurring templates, the
          day rollover, atomic JSON storage. Still no graphical interface.
        </p>
      </description>
    </release>
    <release version="0.1.0" date="2026-08-29">
      <description>
        <p>Project foundations. Not a functional release.</p>
      </description>
    </release>
  </releases>
</component>