# Maintainer: VertOurs <vertours.dev@gmail.com>
pkgname=rature
pkgver=1.2.0
pkgrel=1
pkgdesc="Your day, one line at a time: a daily-list desktop app for GNOME"
arch=('any')
url="https://github.com/VertOurs/Rature"
license=('GPL-3.0-or-later')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita' 'glib2')
makedepends=('meson' 'ninja' 'gettext')
checkdepends=('python-pytest')
_pkgname=Rature
source=("$pkgname-$pkgver.tar.gz::https://github.com/VertOurs/$_pkgname/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('89399314f6d028702f36f7d166b1fa85e8d1181cef2bc67d4176303c2bfd065f')

build() {
  arch-meson "$_pkgname-$pkgver" build
  meson compile -C build
}

check() {
  meson test -C build --no-rebuild
}

package() {
  meson install -C build --destdir "$pkgdir"
}
