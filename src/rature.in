"""Installed entry point for Rature, configured by Meson from rature.in."""

import gettext
import locale
import os
import signal
import sys

PKGDATADIR = "@PKGDATADIR@"

sys.path.insert(1, PKGDATADIR)

from rature.config import LOCALEDIR  # noqa: E402
from rature.i18n import align_time_locale  # noqa: E402

# Ctrl+C in a terminal must kill the app, not surface as a KeyboardInterrupt
# inside the GTK main loop.
signal.signal(signal.SIGINT, signal.SIG_DFL)

# Adopt the environment's locale so strftime and GLib format dates and
# names in the user's language: without this the C locale wins and every
# strftime stays English. A broken LC_* in the environment must not stop
# the app, so fall back to C on locale.Error.
try:
    locale.setlocale(locale.LC_ALL, "")
except locale.Error:
    pass

# setlocale(LC_ALL, "") follows LC_TIME/LANG but ignores LANGUAGE, so the
# dates could stay in a different language than the interface. Realign
# LC_TIME with the message language (SPECIFICATION.md §3.8).
align_time_locale(environ=os.environ)

# gettext's own bindtextdomain/textdomain, not locale's: they are what
# backs gettext.gettext, and every module reaches it through
# `from gettext import gettext as _` (CLAUDE.md §4 rule 7). Not
# gettext.install(): that would put _ in builtins instead.
gettext.bindtextdomain("rature", LOCALEDIR)
gettext.textdomain("rature")


def _load_resources() -> None:
    from gi.repository import Gio

    resource = Gio.Resource.load(os.path.join(PKGDATADIR, "rature.gresource"))
    Gio.resources_register(resource)


if __name__ == "__main__":
    _load_resources()
    from rature.main import main

    sys.exit(main())
